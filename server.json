{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.heznpc/taxi",
  "description": "Local workspace for coordinating AI sessions and tools. macOS source preview with MCP.",
  "version": "1.0.0",
