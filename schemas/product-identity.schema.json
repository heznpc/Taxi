    "npm": { "type": "object" },
    "cli": { "type": "object" },
    "mcp": { "type": "object" },
    "apple": { "type": "object" },
    "runtime": { "type": "object" },
    "paths": { "type": "object" },
    "distribution": { "type": "object" }
  },
  "additionalProperties": false
}
